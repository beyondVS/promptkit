# PromptKit registry configuration (required for all runs)
PROMPTKIT_BASE_URL=http://127.0.0.1:8000/
PROMPTKIT_API_KEY=replace-with-read-only-api-key
PROMPTKIT_PROMPT_SLUG=replace-with-on-live-prompt-slug

# Optional JSON object containing compile parameters. Values may be sensitive.
PROMPTKIT_PROMPT_PARAMS={}

# Gemini configuration (required only when explicitly running with --live)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-accessible-model-name
